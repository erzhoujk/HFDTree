{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/hfdtree/verified_trajectory_pair.schema.json",
  "title": "HFDTree verified same-state trajectory pair",
  "type": "object",
  "required": [
    "task_id",
    "source_record_id",
    "initial_state_fingerprint",
    "positive_trajectory",
    "negative_trajectory"
  ],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "source_record_id": {},
    "initial_state_fingerprint": {"type": "string", "minLength": 1},
    "positive_trajectory": {"$ref": "#/$defs/trajectory"},
    "negative_trajectory": {"$ref": "#/$defs/trajectory"}
  },
  "not": {
    "anyOf": [
      {"required": ["positive_sample"]},
      {"required": ["negative_sample"]}
    ]
  },
  "$defs": {
    "trajectory": {
      "type": "object",
      "required": [
        "trajectory_id",
        "initial_state_fingerprint",
        "turns",
        "outcome",
        "scorer"
      ],
      "properties": {
        "trajectory_id": {"type": "string", "minLength": 1},
        "initial_state_fingerprint": {"type": "string", "minLength": 1},
        "turns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "action",
              "observation",
              "state_fingerprint_before",
              "state_fingerprint_after"
            ],
            "properties": {
              "state_fingerprint_before": {"type": "string", "minLength": 1},
              "state_fingerprint_after": {"type": "string", "minLength": 1}
            }
          }
        },
        "outcome": {
          "type": "object",
          "required": ["safe", "task_success"],
          "properties": {
            "safe": {"type": "boolean"},
            "task_success": {"type": "boolean"},
            "refused": {"type": "boolean"},
            "correct_refusal": {"type": "boolean"}
          }
        },
        "scorer": {
          "type": "object",
          "required": ["name", "version", "verified"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "verified": {"const": true}
          }
        }
      }
    }
  }
}
